{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/libre-devops/terraform-msgraph-xdr-custom-detection-rules/main/schema/custom-detection.schema.json",
  "title": "Libre DevOps custom detection rule",
  "description": "One Defender XDR custom detection rule per YAML file. Mirrors the Terraform module's plan-time validator (the module is authoritative): analysts get the same feedback in the editor via yaml-language-server, and CI can pre-check files with the same schema. Note: frequency is shown here with the service's default schedules; the module validates it against its allowed_frequencies input, which callers can narrow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "query",
    "frequency",
    "alert"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Rule id (client provided on create). Defaults to the file name without extension."
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Logical grouping override. Defaults to the first level folder name."
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "enabled",
        "disabled"
      ],
      "description": "Defaults to enabled."
    },
    "frequency": {
      "enum": [
        "PT0S",
        "PT1H",
        "PT3H",
        "PT12H",
        "PT24H",
        "P1D"
      ],
      "description": "ISO 8601 schedule: every 1, 3, 12 or 24 hours, or PT0S for Continuous (near real time)."
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "The advanced hunting KQL. Must return Timestamp, ReportId and an impacted entity column."
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "entity_mappings"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Defaults to display_name."
        },
        "description": {
          "type": "string",
          "description": "Defaults to the rule description."
        },
        "severity": {
          "enum": [
            "informational",
            "low",
            "medium",
            "high"
          ]
        },
        "recommended_actions": {
          "type": "string"
        },
        "mitre": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tactic"
            ],
            "properties": {
              "tactic": {
                "enum": [
                  "Reconnaissance",
                  "ResourceDevelopment",
                  "InitialAccess",
                  "Execution",
                  "Persistence",
                  "PrivilegeEscalation",
                  "DefenseEvasion",
                  "CredentialAccess",
                  "Discovery",
                  "LateralMovement",
                  "Collection",
                  "CommandAndControl",
                  "Exfiltration",
                  "Impact"
                ]
              },
              "techniques": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^T\\d{4}(\\.\\d{3})?$"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "technique"
                      ],
                      "properties": {
                        "technique": {
                          "type": "string",
                          "pattern": "^T\\d{4}(\\.\\d{3})?$"
                        },
                        "sub_techniques": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^T\\d{4}\\.\\d{3}$"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "custom_details": {
          "type": "object",
          "description": "Detail name to query column name.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "entity_mappings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accounts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/accountsMapping"
              }
            },
            "amazon_resources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/amazonResourcesMapping"
              }
            },
            "azure_resources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/azureResourcesMapping"
              }
            },
            "cloud_applications": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cloudApplicationsMapping"
              }
            },
            "dns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dnsMapping"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/filesMapping"
              }
            },
            "google_cloud_resources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/googleCloudResourcesMapping"
              }
            },
            "hosts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hostsMapping"
              }
            },
            "ips": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ipsMapping"
              }
            },
            "mail_clusters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mailClustersMapping"
              }
            },
            "mail_messages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mailMessagesMapping"
              }
            },
            "mailboxes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/mailboxesMapping"
              }
            },
            "oauth_applications": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/oauthApplicationsMapping"
              }
            },
            "processes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/processesMapping"
              }
            },
            "registry_values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/registryValuesMapping"
              }
            },
            "security_groups": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/securityGroupsMapping"
              }
            },
            "urls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/urlsMapping"
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "accounts"
              ]
            },
            {
              "required": [
                "hosts"
              ]
            },
            {
              "required": [
                "mailboxes"
              ]
            },
            {
              "required": [
                "ips"
              ]
            }
          ],
          "description": "At least one ASSET entity group (accounts, hosts, mailboxes, or ips) is required; related evidence groups alone are rejected by the API."
        }
      }
    },
    "device_groups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Scope the rule to these device groups (organizationalScope)."
    },
    "automated_actions": {
      "type": "object",
      "description": "Automated response actions. Act on real assets when the rule fires; the module refuses them unless allow_automated_actions is true.",
      "additionalProperties": false,
      "properties": {
        "allow_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileAction"
          }
        },
        "block_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileAction"
          }
        },
        "collect_investigation_packages": {
          "deprecated": true,
          "description": "DEPRECATED, removed from the Graph security API on 2026-10-01 with the retirement of standalone AIR (MC1411577). No like-for-like successor; Microsoft points at automatedAction on detectionAction.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviceAction"
          }
        },
        "disable_users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accountSidAction"
          }
        },
        "force_user_password_resets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accountSidAction"
          }
        },
        "hard_delete_emails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emailAction"
          }
        },
        "initiate_investigations": {
          "deprecated": true,
          "description": "DEPRECATED, removed from the Graph security API on 2026-10-01 with the retirement of standalone AIR (MC1411577). Migrate to run_antivirus_scans, which takes the same device_id_column shape.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviceAction"
          }
        },
        "isolate_devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/isolateDeviceAction"
          }
        },
        "mark_users_as_compromised": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accountObjectIdAction"
          }
        },
        "move_emails_to_deleted_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emailAction"
          }
        },
        "move_emails_to_inbox": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emailAction"
          }
        },
        "move_emails_to_junk": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emailAction"
          }
        },
        "restrict_app_executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviceAction"
          }
        },
        "run_antivirus_scans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviceAction"
          }
        },
        "soft_delete_emails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emailAction"
          }
        },
        "stop_and_quarantine_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stopAndQuarantineFileAction"
          }
        }
      }
    },
    "extra_body": {
      "type": "object",
      "description": "Raw Graph shaped attributes merged over the generated body last. Expert escape hatch."
    }
  },
  "$defs": {
    "column": {
      "type": "string",
      "minLength": 1
    },
    "accountsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "aad_user_id_column": {
          "$ref": "#/$defs/column"
        },
        "dns_domain_column": {
          "$ref": "#/$defs/column"
        },
        "name_column": {
          "$ref": "#/$defs/column"
        },
        "nt_domain_column": {
          "$ref": "#/$defs/column"
        },
        "sid_column": {
          "$ref": "#/$defs/column"
        },
        "upn_column": {
          "$ref": "#/$defs/column"
        },
        "upn_suffix_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "amazonResourcesMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "amazon_resource_id_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "azureResourcesMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "resource_id_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "cloudApplicationsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "app_id_column": {
          "$ref": "#/$defs/column"
        },
        "name_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "dnsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "domain_name_column": {
          "$ref": "#/$defs/column"
        },
        "host_ip_address_column": {
          "$ref": "#/$defs/column"
        },
        "server_ip_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "filesMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name_column": {
          "$ref": "#/$defs/column"
        },
        "sha1_column": {
          "$ref": "#/$defs/column"
        },
        "sha256_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "googleCloudResourcesMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "full_resource_name_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "hostsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "device_id_column": {
          "$ref": "#/$defs/column"
        },
        "dns_domain_column": {
          "$ref": "#/$defs/column"
        },
        "name_column": {
          "$ref": "#/$defs/column"
        },
        "net_bios_name_column": {
          "$ref": "#/$defs/column"
        },
        "nt_domain_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "ipsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "address_column": {
          "$ref": "#/$defs/column"
        },
        "scope_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "mailClustersMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "query_column": {
          "$ref": "#/$defs/column"
        },
        "source_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "mailMessagesMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_message_id_column",
        "recipient_column",
        "sender_column"
      ],
      "properties": {
        "network_message_id_column": {
          "$ref": "#/$defs/column"
        },
        "recipient_column": {
          "$ref": "#/$defs/column"
        },
        "sender_column": {
          "$ref": "#/$defs/column"
        },
        "subject_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "mailboxesMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "primary_address_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "oauthApplicationsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "oauth_app_id_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "processesMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sha1_column": {
          "$ref": "#/$defs/column"
        },
        "sha256_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "registryValuesMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "key_column": {
          "$ref": "#/$defs/column"
        },
        "value_name_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "securityGroupsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "distinguished_name_column": {
          "$ref": "#/$defs/column"
        },
        "object_id_column": {
          "$ref": "#/$defs/column"
        },
        "sid_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "urlsMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "address_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "deviceAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id_column"
      ],
      "properties": {
        "device_id_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "isolateDeviceAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id_column"
      ],
      "properties": {
        "device_id_column": {
          "$ref": "#/$defs/column"
        },
        "isolation_type": {
          "enum": [
            "full",
            "selective"
          ]
        }
      }
    },
    "fileAction": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sha1_column": {
          "$ref": "#/$defs/column"
        },
        "sha256_column": {
          "$ref": "#/$defs/column"
        },
        "device_group_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stopAndQuarantineFileAction": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "device_id_column": {
          "$ref": "#/$defs/column"
        },
        "sha1_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "accountSidAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_sid_column"
      ],
      "properties": {
        "account_sid_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "accountObjectIdAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_object_id_column"
      ],
      "properties": {
        "account_object_id_column": {
          "$ref": "#/$defs/column"
        }
      }
    },
    "emailAction": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "network_message_id_column": {
          "$ref": "#/$defs/column"
        },
        "recipient_column": {
          "$ref": "#/$defs/column"
        }
      }
    }
  }
}
